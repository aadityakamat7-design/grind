{
  "name": "WorkRecord",
  "type": "object",
  "properties": {
    "record_id": {
      "type": "string",
      "description": "Public verification id embedded in the PDF and the blockwork.online/verify/{id} link"
    },
    "teen_user_id": {
      "type": "string"
    },
    "teen_display_name": {
      "type": "string",
      "description": "First name + last initial only"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "The teen or their parent can turn the public verification link off at any time"
    },
    "jobs_completed": {
      "type": "number",
      "default": 0,
      "description": "Completed, paid-out bookings only \u2014 nothing can be typed in by hand"
    },
    "hours_total": {
      "type": "number",
      "default": 0
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "avg_rating": {
      "type": "number"
    },
    "review_count": {
      "type": "number",
      "default": 0
    },
    "jobs": {
      "type": "array",
      "description": "Every completed job, newest first. The neighbor is anonymized as 'Neighbor in <city>, <state>' \u2014 no names or addresses.",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "neighbor_label": {
            "type": "string"
          }
        }
      }
    },
    "reviews": {
      "type": "array",
      "description": "Up to 5 review quotes, newest first",
      "items": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "number"
          },
          "quote": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    },
    "first_job_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_job_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "record_id",
    "teen_user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.teen_user_id": "{{user.id}}"
        },
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.teen_user_id": "{{user.id}}"
        },
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}