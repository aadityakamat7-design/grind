{
  "name": "ParentTeenLink",
  "type": "object",
  "properties": {
    "parent_user_id": {
      "type": "string"
    },
    "teen_user_id": {
      "type": "string"
    },
    "teen_profile_id": {
      "type": "string"
    },
    "teen_display_name": {
      "type": "string"
    },
    "identity_verified": {
      "type": "boolean",
      "default": false,
      "description": "Check 1: parent passed Stripe Identity (ID + liveness)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "relationship_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Check 2: parent entered the teen's invite code and explicitly attested the relationship",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "relationship_attested_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed"
      ],
      "default": "pending",
      "description": "Confirmed once the parent attested the relationship with the teen's code (set server-side)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admin_review_flag": {
      "type": "boolean",
      "default": false,
      "description": "Set when the parent account shows a self-linking signal (created on the same device or IP as the teen within 24 hours). Never blocks the link \u2014 admins review it (server-set only).",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admin_review_reason": {
      "type": "string",
      "maxLength": 200,
      "description": "Why this link was flagged, e.g. 'Possible self-linked parent' (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "flagged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the self-linking signal was recorded (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "withdrawals_locked": {
      "type": "boolean",
      "default": false,
      "description": "When true, the teen cannot cash out their Blockwork Wallet balance. The parent toggles this from their dashboard. No field-level RLS \u2014 the parent can update it via the entity-level update rule."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "parent_user_id",
    "teen_user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "data.teen_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}