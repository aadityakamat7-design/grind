{
  "name": "SavedAddress",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The neighbor this address belongs to"
    },
    "label": {
      "type": "string",
      "maxLength": 30,
      "description": "A short name for the place, e.g. 'Home' or \"Mom's house\""
    },
    "address": {
      "type": "string",
      "maxLength": 200,
      "description": "Street address, verified against California on the server before it is saved"
    },
    "zip": {
      "type": "string",
      "maxLength": 10
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "US state resolved by geocoding \u2014 must be CA"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "job_notes": {
      "type": "string",
      "maxLength": 500,
      "description": "Practical notes for the worker (gate code, pets, parking). Never shown until the booking is approved \u2014 the server strips them out of anything a teen can see earlier."
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "The address used by default when this neighbor books a job"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id",
    "address",
    "zip"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}