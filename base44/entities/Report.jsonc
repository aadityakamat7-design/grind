{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string"
    },
    "reporter_name": {
      "type": "string"
    },
    "subject_id": {
      "type": "string",
      "description": "User being reported"
    },
    "subject_name": {
      "type": "string"
    },
    "booking_id": {
      "type": "string"
    },
    "review_id": {
      "type": "string",
      "description": "Set when this report flags a specific review, so admins can hide it"
    },
    "message_flag_id": {
      "type": "string",
      "description": "Set when this report came from the automatic message safety monitor, linking it to the flagged-message record"
    },
    "reason": {
      "type": "string",
      "enum": [
        "safety",
        "off_platform",
        "inappropriate",
        "spam",
        "other"
      ]
    },
    "details": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "normal",
        "urgent"
      ],
      "default": "normal",
      "description": "urgent = a blocked high-risk message, a sexual-content incident, or an SOS. Shown at the top of the admin safety queue with the NCMEC notice (server-set only)."
    },
    "auto_flagged": {
      "type": "boolean",
      "default": false,
      "description": "True when the automatic safety monitor created this report rather than a person (server-set only)"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ],
      "default": "open"
    }
  },
  "required": [
    "reporter_id",
    "subject_id",
    "reason"
  ],
  "rls": {
    "create": {
      "data.reporter_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.reporter_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}