{
  "name": "JobPost",
  "type": "object",
  "properties": {
    "buyer_user_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "tutoring",
        "tech_help",
        "lawn_care",
        "car_washing",
        "odd_jobs",
        "pet_sitting"
      ]
    },
    "delivery_mode": {
      "type": "string",
      "enum": [
        "outdoor",
        "online"
      ],
      "description": "outdoor = work at the residence exterior; online = remote video session. Set server-side from the category \u2014 teens never enter a client's home."
    },
    "price": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 500,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "price_model": {
      "type": "string",
      "enum": [
        "FIXED",
        "HOURLY"
      ],
      "default": "FIXED"
    },
    "zip": {
      "type": "string"
    },
    "is_physical": {
      "type": "boolean",
      "default": true,
      "description": "Whether this job requires being physically present at a location"
    },
    "address": {
      "type": "string",
      "description": "Job site address \u2014 readable only by the buyer who owns the post and admins. Revealed to the teen and parent only after the booking is approved, via the Booking entity. Server functions strip this before sending open jobs to the client. Never set for online jobs.",
      "rls": {
        "read": {
          "$or": [
            {
              "data.buyer_user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "state": {
      "type": "string",
      "description": "US state used for the child labor law compliance check"
    },
    "scheduled_start": {
      "type": "string",
      "format": "date-time"
    },
    "ai_approved": {
      "type": "boolean",
      "default": false,
      "description": "Passed the AI child labor law screening"
    },
    "ai_minimum_age": {
      "type": "number",
      "description": "Minimum teen age allowed under state law per AI screening"
    },
    "ai_law_notes": {
      "type": "string",
      "description": "AI notes on state law conditions (hours, supervision, equipment)"
    },
    "is_asap": {
      "type": "boolean",
      "default": false,
      "description": "Free neighbor toggle \u2014 ASAP jobs are sorted to the top of the teen job board and badged so urgent work gets pushed harder to teens looking for work.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 7-day no-taker window ends. Set server-side when the posting payment clears. After this, the job auto-expires and the neighbor chooses a refund or platform credit.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open",
        "assigned",
        "cancelled",
        "expired"
      ],
      "default": "draft",
      "description": "Draft until the posting payment clears (then open). expired = no teen took it within 7 days, pending the neighbor's refund/credit choice.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "assigned_teen_user_id": {
      "type": "string"
    },
    "assigned_teen_name": {
      "type": "string"
    },
    "booking_id": {
      "type": "string"
    },
    "charge_amount": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000,
      "description": "Amount the buyer paid upfront to post this job (held in escrow). Reduced by any applied platform credit.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "platform_fee": {
      "type": "number",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "net_amount": {
      "type": "number",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "held",
        "refunded",
        "credited"
      ],
      "default": "unpaid",
      "description": "Escrow status for the upfront posting payment. held = paid and escrowed; refunded = expired/cancelled and refunded to the neighbor's card; credited = expired and converted to platform credit.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_session_id": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_test_mode": {
      "type": "boolean",
      "default": false,
      "description": "True when this post's upfront charge was created under Stripe test mode (admin toggle). Test-mode posts never involve real money.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "applied_credit": {
      "type": "number",
      "default": 0,
      "description": "Platform credit applied to reduce this post's upfront charge (server-set only).",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "buyer_user_id",
    "title",
    "category",
    "price",
    "state"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.buyer_user_id": "{{user.id}}"
        },
        {
          "data.assigned_teen_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.buyer_user_id": "{{user.id}}"
        },
        {
          "data.assigned_teen_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.buyer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}