{
  "name": "BuyerProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "description": "Buyer home address \u2014 readable only by the owner and admins (RLS-enforced). Revealed to the teen/parent only after a booking is confirmed, via the Booking entity.",
      "rls": {
        "read": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "zip": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "US state resolved from geocoding, used for cross-state booking restrictions"
    },
    "latitude": {
      "type": "number",
      "description": "Geocoded latitude \u2014 readable only by the owner and admins; used only server-side for distance matching",
      "rls": {
        "read": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "longitude": {
      "type": "number",
      "description": "Geocoded longitude \u2014 readable only by the owner and admins; used only server-side for distance matching",
      "rls": {
        "read": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "resolved_city": {
      "type": "string",
      "description": "City resolved from geocoding"
    },
    "avg_rating": {
      "type": "number",
      "default": 0,
      "description": "Average rating from teens who worked for this neighbor"
    },
    "review_count": {
      "type": "number",
      "default": 0
    },
    "jobs_completed": {
      "type": "number",
      "default": 0,
      "description": "Total jobs completed as a neighbor (incremented server-side when a booking's payment is released)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "availability": {
      "type": "array",
      "description": "Weekly recurring availability slots the neighbor set on their Availability tab \u2014 when they're usually home and available for service. Each entry: { day: 0-6 (Sun-Sat), start: 'HH:mm', end: 'HH:mm' }.",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "number",
            "minimum": 0,
            "maximum": 6
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}