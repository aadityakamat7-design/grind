{
  "name": "BuyerProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "description": "Buyer home address \u2014 readable only by the owner and admins (RLS-enforced). Revealed to the teen/parent only after a booking is confirmed, via the Booking entity.",
      "rls": {
        "read": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "zip": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "US state resolved from geocoding, used for cross-state booking restrictions"
    },
    "latitude": {
      "type": "number",
      "description": "Geocoded latitude \u2014 readable only by the owner and admins; used only server-side for distance matching",
      "rls": {
        "read": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "longitude": {
      "type": "number",
      "description": "Geocoded longitude \u2014 readable only by the owner and admins; used only server-side for distance matching",
      "rls": {
        "read": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "resolved_city": {
      "type": "string",
      "description": "City resolved from geocoding"
    },
    "id_verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "failed"
      ],
      "default": "pending",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "identity_session_id": {
      "type": "string",
      "description": "Stripe Identity verification session id for the buyer",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "referral_code": {
      "type": "string",
      "description": "This neighbor's shareable referral code"
    },
    "referral_credit": {
      "type": "number",
      "default": 0,
      "description": "Credit balance auto-applied to the next booking"
    },
    "avg_rating": {
      "type": "number",
      "default": 0,
      "description": "Average rating from teens who worked for this neighbor"
    },
    "review_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}