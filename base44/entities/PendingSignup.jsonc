{
  "name": "PendingSignup",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "One-time random token carried through the sign-in redirect (Google, Apple, Facebook) so the age check, invite code and destination survive it"
    },
    "role": {
      "type": "string",
      "enum": [
        "teen",
        "parent",
        "buyer"
      ],
      "description": "The role the person picked at the age check. Empty when the token only carries an invite code or destination."
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "The date of birth entered at the age check (already validated for this role). Empty when the token only carries an invite code or destination."
    },
    "invite_code": {
      "type": "string",
      "description": "A parent invite code that came in on the link, kept here so it survives the sign-in redirect"
    },
    "destination": {
      "type": "string",
      "description": "The in-app page the person was heading to (an approval link, for example) \u2014 a same-site path only"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "15 minutes after the token was created"
    },
    "consumed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set when the token was attached to an account, so it can never be used twice"
    },
    "ip": {
      "type": "string",
      "description": "Client IP, used only to rate-limit the age check"
    }
  },
  "required": [
    "token",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}