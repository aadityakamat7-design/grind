{
  "name": "User",
  "type": "object",
  "properties": {
    "app_role": {
      "type": "string",
      "enum": [
        "teen",
        "parent",
        "buyer",
        "admin"
      ],
      "description": "The Blockwork role selected during onboarding (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "onboarded": {
      "type": "boolean",
      "default": false,
      "description": "Set true once onboarding_step reaches done (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "onboarding_step": {
      "type": "string",
      "enum": [
        "account_created",
        "profile_complete",
        "parent_link_shown",
        "done"
      ],
      "description": "Where this account is in sign-up. Every page load sends an unfinished account to its next step. Accounts created before this field existed have no step and are treated as done when onboarded (server-set only).",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "signup_role": {
      "type": "string",
      "enum": [
        "teen",
        "parent",
        "buyer"
      ],
      "description": "The role the person picked at the age check, re-validated on the server before it is saved here (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "signup_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the age check result was attached to this account (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "auth_method": {
      "type": "string",
      "enum": [
        "password",
        "google",
        "apple",
        "facebook"
      ],
      "description": "How this account was first created, so entering the same email later can say 'this email uses Google sign-in' instead of making a duplicate. Empty on older accounts (server-set only).",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "saved_destination": {
      "type": "string",
      "description": "The in-app page the person was heading to before sign-in (an approval link, for example). Used once, when sign-up finishes, then cleared (server-set only).",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "pending_invite_code": {
      "type": "string",
      "description": "A parent invite code saved at sign-up so the link confirmation screen opens with it filled in. Cleared when sign-up finishes (server-set only).",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "contact_email": {
      "type": "string",
      "description": "An email the person typed and confirmed themselves, saved when their sign-in provider (for example Facebook) did not return one"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Collected at the age check for age verification (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "work_state": {
      "type": "string",
      "description": "US state code for work eligibility (teens) (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "has_seen_tour": {
      "type": "boolean",
      "default": false,
      "description": "True once the welcome tour has been finished or skipped. Stored on the account (not the browser) so the tour never restarts on another device."
    },
    "terms_accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the user accepted the Terms of Service"
    },
    "terms_version": {
      "type": "string",
      "description": "Version of the ToS the user accepted"
    },
    "payment_auth_acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the parent acknowledged payment authorization"
    },
    "recovery_phone": {
      "type": "string",
      "description": "Phone number for account recovery \u2014 private, visible only to the user and support"
    },
    "marketing_emails_unsubscribed": {
      "type": "boolean",
      "default": false,
      "description": "True when the user has unsubscribed from marketing emails via the one-click unsubscribe link. Transactional emails (receipts, booking notices, security) are not affected."
    },
    "parent_weekly_summary": {
      "type": "boolean",
      "default": true,
      "description": "Whether the parent receives the Sunday 6 PM weekly summary email. Parents can turn it off in their notification settings."
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active",
      "description": "Set to suspended by Blockwork support when an account must stop acting on the marketplace (admin-set only). A suspended account can still sign in and see its own records, and work already agreed stays in place \u2014 it just cannot start anything new.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "account_status_reason": {
      "type": "string",
      "maxLength": 500,
      "description": "Why the account is on hold \u2014 shown to the account holder and recorded in the admin audit log (admin-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "messaging_suspended": {
      "type": "boolean",
      "default": false,
      "description": "Set by the safety monitor when a user sends sexual content directed at a minor \u2014 they cannot send messages until an admin reviews and lifts it (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "messaging_suspended_reason": {
      "type": "string",
      "maxLength": 500,
      "description": "Why messaging is suspended (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  }
}