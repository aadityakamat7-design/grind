{
  "name": "Booking",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "string"
    },
    "listing_title": {
      "type": "string",
      "maxLength": 80
    },
    "teen_user_id": {
      "type": "string"
    },
    "teen_display_name": {
      "type": "string",
      "maxLength": 50
    },
    "parent_user_id": {
      "type": "string"
    },
    "buyer_user_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string",
      "maxLength": 80
    },
    "scheduled_start": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_mode": {
      "type": "string",
      "enum": [
        "outdoor",
        "online"
      ],
      "description": "outdoor = work at the residence exterior; online = remote video session. Set server-side from the listing category."
    },
    "address": {
      "type": "string",
      "description": "Buyer address, revealed only when confirmed. Never set for online bookings."
    },
    "session_link": {
      "type": "string",
      "description": "Video call link for online bookings \u2014 generated server-side at booking creation, visible to both parties and the parent."
    },
    "is_physical": {
      "type": "boolean",
      "default": true,
      "description": "Whether this job requires being physically present at a location"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly"
      ]
    },
    "teen_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the teen confirmed Start job \u2014 the job only starts once both sides confirm (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "buyer_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the neighbor confirmed Start job \u2014 the job only starts once both sides confirm (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "teen_finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the teen marked the job finished and uploaded completion photos \u2014 starts the 12-hour buyer confirmation window (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "completion_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos the teen uploaded as proof the work was done \u2014 shown to the buyer for confirmation and to admins during dispute review (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "buyer_finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the neighbor confirmed the job was done correctly \u2014 triggers payment release (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "buyer_disputed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the neighbor reported the teen did not do the job \u2014 holds escrow pending admin review (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "dispute_reason": {
      "type": "string",
      "maxLength": 500,
      "description": "The neighbor's explanation of why the work was not done correctly (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admin_resolution": {
      "type": "string",
      "enum": [
        "none",
        "released",
        "refunded"
      ],
      "default": "none",
      "description": "Admin's decision on a disputed booking: released = teen did the work, refunded = neighbor gets their money back (server-set only)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "tip_amount": {
      "type": "number",
      "minimum": 0,
      "maximum": 200,
      "default": 0,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_parent_approval",
        "confirmed",
        "in_progress",
        "completed",
        "cancelled",
        "denied",
        "disputed"
      ],
      "default": "pending_parent_approval",
      "description": "Advanced to in_progress/completed only by the server. disputed = neighbor reported the work wasn't done, pending admin review.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "price_total": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "charge_amount": {
      "type": "number",
      "minimum": 0,
      "maximum": 2000,
      "description": "Amount the buyer actually pays after referral credit",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "estimated_hours": {
      "type": "number",
      "minimum": 0,
      "maximum": 24,
      "default": 2,
      "description": "Estimated duration in hours \u2014 used to enforce daily/weekly work-hour limits for minors. Set from the hours param for HOURLY listings; defaults to 2 for FIXED listings. Server-set only.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "platform_fee": {
      "type": "number",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "net_amount": {
      "type": "number",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "held",
        "releasing",
        "released",
        "refunded"
      ],
      "default": "unpaid",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "is_test_mode": {
      "type": "boolean",
      "default": false,
      "description": "True when this booking's charge was created under Stripe test mode (admin toggle). Test-mode bookings never involve real money and are marked so they can't be confused with real transactions later.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "payout_status": {
      "type": "string",
      "enum": [
        "not_started",
        "awaiting_bank",
        "pending_review",
        "transferred"
      ],
      "default": "not_started",
      "description": "Stage of the Stripe Connect transfer to the parent",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "payout_review_reason": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_transfer_id": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "released_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "transferred_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_session_id": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "dispute_flagged_at": {
      "type": "string",
      "format": "date-time",
      "description": "Legacy field \u2014 set when a one-sided completion was flagged for review after the timeout window",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the 'starting soon' reminder notification has been sent"
    },
    "review_reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the 'leave a review' reminder has been sent for this completed booking"
    }
  },
  "required": [
    "teen_user_id",
    "buyer_user_id",
    "price_total"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.teen_user_id": "{{user.id}}"
        },
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "data.buyer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.teen_user_id": "{{user.id}}"
        },
        {
          "data.parent_user_id": "{{user.id}}"
        },
        {
          "data.buyer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}