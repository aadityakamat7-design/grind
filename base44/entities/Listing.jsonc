{
  "name": "Listing",
  "type": "object",
  "properties": {
    "teen_user_id": {
      "type": "string"
    },
    "teen_profile_id": {
      "type": "string"
    },
    "teen_display_name": {
      "type": "string",
      "maxLength": 50
    },
    "teen_zip": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "tutoring",
        "tech_help",
        "lawn_care",
        "car_washing",
        "odd_jobs",
        "pet_sitting"
      ]
    },
    "delivery_mode": {
      "type": "string",
      "enum": [
        "outdoor",
        "online"
      ],
      "description": "outdoor = work at the residence exterior; online = remote video session. Set server-side from the category \u2014 teens never enter a client's home."
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "price_model": {
      "type": "string",
      "enum": [
        "FIXED",
        "HOURLY"
      ],
      "default": "FIXED"
    },
    "price": {
      "type": "number",
      "minimum": 1,
      "maximum": 500,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "availability": {
      "type": "array",
      "description": "Weekly recurring availability slots set by the teen. Each entry: { day: 0-6 (Sun-Sat), start: 'HH:mm', end: 'HH:mm' }. The booking calendar only shows these days/times, filtered to legal work hours.",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "number",
            "minimum": 0,
            "maximum": 6
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        }
      },
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "teen_hour_limits": {
      "type": "object",
      "description": "Snapshot of the teen's legal work-hour limits at listing creation time, so the booking calendar can filter to legal times without needing access to the teen's private age data. Set server-side only.",
      "properties": {
        "maxDailyHoursSchoolDay": {
          "type": "number"
        },
        "maxDailyHoursNonSchoolDay": {
          "type": "number"
        },
        "maxWeeklyHoursSchoolWeek": {
          "type": "number"
        },
        "maxWeeklyHoursSummer": {
          "type": "number"
        },
        "earliestStartHour": {
          "type": "number"
        },
        "latestEndHour": {
          "type": "number"
        },
        "latestEndHourSummer": {
          "type": "number"
        },
        "prohibitedDuringSchoolHours": {
          "type": "boolean"
        },
        "schoolHoursStart": {
          "type": "number"
        },
        "schoolHoursEnd": {
          "type": "number"
        }
      },
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_area": {
      "type": "string",
      "description": "ZIP served"
    },
    "is_hazard_flagged": {
      "type": "boolean",
      "default": false,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "hazard_reason": {
      "type": "string",
      "maxLength": 500,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "paused"
      ],
      "default": "published"
    }
  },
  "required": [
    "teen_user_id",
    "category",
    "title",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.teen_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.teen_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}