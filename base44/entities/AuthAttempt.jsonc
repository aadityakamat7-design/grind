{
  "name": "AuthAttempt",
  "type": "object",
  "properties": {
    "ip": {
      "type": "string",
      "description": "Client IP address of the auth attempt"
    },
    "action": {
      "type": "string",
      "enum": [
        "login",
        "register",
        "reset-request",
        "resend-otp",
        "reset-password"
      ],
      "description": "Auth action being rate-limited"
    },
    "success": {
      "type": "boolean",
      "default": false,
      "description": "Whether the auth attempt succeeded (for analytics/cleanup)"
    },
    "user_id": {
      "type": "string",
      "description": "The user this attempt belongs to \u2014 recorded server-side on a successful sign-up so a later parent link from the same machine can be flagged for review"
    },
    "user_agent": {
      "type": "string",
      "description": "Device user agent recorded at sign-up (server-side, for the same-device review flag)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional context note about this auth attempt"
    }
  },
  "required": [
    "ip",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}