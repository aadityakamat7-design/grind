{
  "name": "Waitlist",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email address of the user who wants to be notified when Blockwork launches in their state"
    },
    "state": {
      "type": "string",
      "description": "US state code the user is located in (non-CA, since CA users can sign up directly)"
    },
    "role": {
      "type": "string",
      "enum": [
        "teen",
        "parent",
        "buyer"
      ],
      "description": "Role the user intended to sign up as"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}