{
  "name": "Credential",
  "type": "object",
  "properties": {
    "teen_user_id": {
      "type": "string",
      "description": "Owning teen user id"
    },
    "teen_display_name": {
      "type": "string",
      "description": "Denormalized for admin review queue display"
    },
    "listing_id": {
      "type": "string",
      "description": "Listing this credential verifies"
    },
    "listing_title": {
      "type": "string",
      "description": "Denormalized for admin review queue display"
    },
    "category": {
      "type": "string",
      "description": "Skill category this credential applies to"
    },
    "label": {
      "type": "string",
      "maxLength": 100,
      "description": "Short label e.g. 'SAT Math: 780'"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded proof file (screenshot/PDF/photo) \u2014 readable only by the owning teen and admins",
      "rls": {
        "read": {
          "$or": [
            {
              "data.teen_user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Admin review status \u2014 the Verified skill badge only appears when approved",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "rejection_reason": {
      "type": "string",
      "maxLength": 500,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "reviewed_by_id": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "teen_user_id",
    "listing_id",
    "label",
    "file_url"
  ],
  "rls": {
    "create": {
      "data.teen_user_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.teen_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.teen_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}