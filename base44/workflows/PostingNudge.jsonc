{
  "name": "Posting Nudge",
  "description": "Weekly email to neighbors who have never posted a job, encouraging them to post their first one. Stops nudging a neighbor once they've posted.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "posting_nudge",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "nudge": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendPostingNudge",
            "args": {
              "_workflowSecret": "ks_wf_8f3a7b2c5e8d1a4f6b9c3e7a2d5f8b1e"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email inactive neighbors",
            "description": "Send a 'post your first job' nudge to neighbors who haven't posted yet"
          }
        }
      }
    ]
  }
}